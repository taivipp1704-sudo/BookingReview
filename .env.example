MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_DATABASE=claritycam_platform
MYSQL_USER=claritycam_user
MYSQL_PASSWORD=replace-with-a-long-random-password

DB_URL=jdbc:mysql://localhost:3306/claritycam_platform?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=claritycam_user
DB_PASSWORD=replace-with-a-long-random-password
CORS_ORIGINS=http://127.0.0.1:5175,http://localhost:5175
SEED_DEMO_DATA=true
BOOTSTRAP_ADMIN=false
CLARITYCAM_ADMIN_EMAIL=admin@claritycam.local
CLARITYCAM_ADMIN_PASSWORD=replace-with-a-long-random-password
OTP_EXPOSE_DEMO_CODE=true
SESSION_COOKIE_SECURE=false
IDENTITY_ENCRYPTION_KEY=replace-with-a-long-random-secret
IDENTITY_STORAGE_PROVIDER=local
IDENTITY_STORAGE=./private-data/identity
