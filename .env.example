# Runtime database user: only SELECT, INSERT, UPDATE and DELETE on the application schema.
DB_URL=jdbc:mysql://localhost:3306/claritycam_platform?useSSL=true&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=claritycam_app
DB_PASSWORD=replace-with-a-long-random-secret
FLYWAY_USERNAME=claritycam_migration
FLYWAY_PASSWORD=replace-with-a-different-long-random-secret

CORS_ORIGINS=https://your-frontend.example
SESSION_COOKIE_SECURE=true
BOOKING_ENABLED=false
EARLY_ACCESS_REGISTRATION_ENABLED=true
JPA_DDL_AUTO=validate
SEED_DEMO_DATA=false
BOOTSTRAP_ADMIN=false

CLARITYCAM_ADMIN_EMAIL=admin@example.com
CLARITYCAM_ADMIN_PASSWORD=replace-with-a-long-random-secret
IDENTITY_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes

SMS_PROVIDER=none
OTP_EXPOSE_DEMO_CODE=false
